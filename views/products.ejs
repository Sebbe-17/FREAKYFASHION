<!doctype html>
<html lang="en">

<head>
  <title><%= product.name %></title>
</head>

<body>
  <!-- Main -->
  <main>
    <section class="details">
      <div class="detail-image">  <!-- Bild -->
        <a href=""><img src="https://placehold.co/200x300?text=<%= product.name %>" alt="<%= product.name %>" /></a>
      </div>
      <div class="detail-info">  <!-- Text/Info -->
        <h1><b><%= product.name %></b></h1>
        <span>levis</span>
        <p>
          Lorem ipsum dolor sit, amet consectetur adipisicing elit. Voluptate
          laborum sed fugit quo. Dolorum enim quibusdam cumque explicabo ea
          officia at, incidunt nostrum exercitationem ullam. Adipisci quaerat
          reiciendis, est ipsum illum consectetur? Quidem odit esse in
          similique deleniti omnis asperiores?
        </p>
        <h2><%= product.price %>: SEK</h2>
        <button class="add-wares">Lägg i varukorg</button>  <!-- Knapp -->
      </div>
    </section>

    <!-- Liknande produkter, dynamiska, 3 stycken -->
    <h2 class="section-title">Liknande produkter</h2>
    <section class="similar-products">
      <dl>
        <% products.slice(0, 3).forEach(product => { %>
          <li>
          <a href="<%= product.id %>"><img src="https://placehold.co/200x300?text=<%= product.name %>" alt="<%= product.name %>" /></a> <!-- Länk till produkt inom samma mapp-->
          <a href="#"><i class="bi bi-suit-heart"></i></a>
          </li>

          <li>
          <span><%= product.name %></span>
          <span><%= product.price %> SEK</span>
          <p>levis</p>
          </li>
        <% }); %>
      </dl>
    </section>
  </main>
</body>
</html>