<!DOCTYPE html>
<section class="hero-section" id="hero"></section>

<script>  // Hero content, can be easily changed to fetch from database or API in the future
  const hero = {
    image: "https://placehold.co/400x250?text=Hero",
    title: "Lorem ipsum dolor",
    description:
      "Lorem ipsum dolor sit amet consectetur adipisicing elit. Quia, ipsam quod? Earum, quis explicabo accusamus odit repellat deleniti quam labore.."
  };

  // Dynamically insert hero content into the page
  document.getElementById("hero").innerHTML = `
    <div class="hero-image">
      <img src="${hero.image}" alt="${hero.title}" />
    </div>
    <div>
      <h1>${hero.title}</h1>
      <p>${hero.description}</p>
    </div>
  `;
</script>