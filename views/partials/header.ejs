<!DOCTYPE html>
<header class="site-header">

<section>
  <div>  <!-- Logo, link to homepage -->
    <a href="/">
      <img src="https://placehold.co/200x100?text=Logo" alt="Logotype" />
    </a>
  </div>

  <!-- Search and Icons -->
  <div class="search-and-icons">
    <form class="search-bar" action="/search" method="GET">  <!-- Search field -->
      <i class="bi bi-search"></i>  <!-- Search icon (Bootstrap) -->
      <input type="search" name="q" placeholder="Search product" /> <!-- The search field sends a GET request to /search with the search parameter -->
      <button type="submit">Sök</button>
    </form>
    <!-- Icons -->
    <div class="icons">
      <a href="#"><i class="bi bi-suit-heart-fill"></i></a><a href="#"><i class="bi bi-basket3-fill"></i></a>  <!-- Hjärta och Varukorg ikoner (Bootstrap) -->
    </div>
  </div>
</section>

<!-- Main Menu -->
<nav>
  <ul class="main-menu">  <!-- Dynamically generates links to category pages based on the categories database -->
    <% categories.forEach(category => { %>
      <li><a href="/categories/<%= category.id %>"><%= category.name %></a></li>
    <% }); %>
  </ul>
</nav>
</header>