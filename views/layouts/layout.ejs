<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <title><%= title %></title>
</head>
<body>
    <!-- Header -->
    <header class="site-header">
    <section>
      <div>  <!-- Logotyp, länk till huvudsidan -->
        <a href="/">
          <img src="https://placehold.co/200x100?text=Logo" alt="Logotype" />
        </a>
      </div>

      <!-- Sökfält och ikoner -->
      <div class="search-and-icons">
        <form class="search-bar" action="/search" method="GET">  <!-- Sökfält -->
          <i class="bi bi-search"></i>  <!-- Sök-ikon (Bootstrap) -->
          <input type="search" name="q" placeholder="Sök produkt" /> <!-- Sökfältet skickar en GET-förfrågan till /search med sökparametern -->
          <button type="submit">Sök</button>
        </form>
        <!-- ikoner -->
        <div class="icons">
          <a href="#"><i class="bi bi-suit-heart"></i></a><a href="#"><i class="bi bi-basket3"></i></a>  <!-- Hjärta och Varukorg ikoner (Bootstrap) -->
        </div>
      </div>
    </section>

    <!-- Huvudmeny -->
    <nav>
      <ul class="main-menu">
        <li><a href="/categories/kläder">Kläder</a></li>
        <li><a href="/categories/accessoarer">Accessoarer</a></li>
        <li><a href="/categories/skor">Skor</a></li>
      </ul>
    </nav>
  </header>

  <%- body %>

  <!-- Footer -->
  <footer class="site-footer">
    <!-- Fördelar -->
    <section class="benefits"> <!-- (ikoner > text) -->
      <div>
        <i class="bi bi-globe-americas"></i>  <!-- Glob-ikon (Bootstrap) -->
        <a href="#">Gratis frakt och returer</a>
      </div>

      <div>
        <i class="bi bi-airplane-engines"></i>  <!-- Flygplans-ikon (Bootstrap) -->
        <a href="#">Expressleverans</a>
      </div>

      <div>
        <i class="bi bi-shield-shaded"></i>  <!-- Sköld-ikon (Bootstrap) -->
        <a href="#">Säkra betalningar</a>
      </div>

      <div>
        <i class="bi bi-envelope-paper"></i>  <!-- Nyhetsbrev-ikon (Bootstrap) -->
        <a href="#">Nyheter varje dag</a>
      </div>
    </section>

    <section class="gray-footer">
      <section class="footer-menu">  <!-- Footer-meny -->
        <!-- Row 1 -->
        <div class="footer-links">
          <a href="#"><b>Shopping</b></a>
          <a href="#">Vinterjackor</a>
          <a href="#">Pufferjackor</a>
          <a href="#">Kappa</a>
          <a href="#">Trenchcoats</a>
        </div>

        <!-- Row 2 -->
        <div class="footer-links">
          <a href="#"><b>Minasidor</b></a>
          <a href="#">Mina beställningar</a>
          <a href="#">Mitt konto</a>
        </div>

        <!-- Row 3 -->
        <div class="footer-links">
          <a href="#"><b>Kundtjänst</b></a>
          <a href="#">Returpolicy</a>
          <a href="#">Integritetspolicy</a>
        </div>
      </section>
      
      <!-- Copyright -->
      <section class="copyright">
        <i class="bi bi-c-circle"></i>
        <p>freaky fashion</p>
      </section>
  </section>
  </footer>
</body>
</html>