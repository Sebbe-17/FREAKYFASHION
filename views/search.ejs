<!DOCTYPE html>
<html lang="en">

<head>
  <link rel="stylesheet" href="stylesheets/index.css" />  <!-- Resuses index.css due to shared styles -->
  <link rel="stylesheet" href="stylesheets/search.css" />
</head>

<body>
    <main>
        <!-- Ger olika meddelanden beroende på antal sökresultat -->

        <!-- Om ingen produkt hittas, visas ett meddelande -->
        <% if (products.length === 0) { %>
          <div class="search-results-header">
            <p>Inga produkter hittades som matchar sökningen.</p>
          </div>
        <% } %>

        <!-- om bara ett sökresultat hittadess visa medelande -->
        <% if (products.length === 1) { %>
          <div class="search-results-header">
            <h1>Sökresultat</h1>
            <p>Hittade en produkt med termen "<%= query %>".</p>
          </div>
        <% } %>

          <!-- Om flera sökresultat hittas, visa meddelande -->
        <% if (products.length > 1) { %>
          <div class="search-results-header">
            <h1>Sökresultat</h1>  
            <p>Hittade <%=(products.length)%> produkter med termen "<%= query %>".</p>
          </div>
        <% } %>

        <!-- visar produkter med namn som innehåller söktermen -->
        <section class="Product-cards"> 
          <dl>
            <% products.forEach(product => { %>
              <li>
                <div class="image-link">
                  <a class="image-link" href="products/<%= product.id %>"><img src="https://placehold.co/200x300?text=<%= product.name %>" alt="<%= product.name %>" /></a>
                  <a href="#" class="icon"><i class="bi bi-suit-heart"></i></a>
                </div>

                <div class="info">
                  <span class="name"><%= product.name %></span>
                  <span><%= product.price %> SEK</span>
                </div>
                <span class="brand">levis</span>
              </li>
            <% }); %>
          </dl>
      </section>
    </main>
</body>
</html>