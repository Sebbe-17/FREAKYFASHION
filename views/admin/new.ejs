<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/admin-new.css">
    <title>Products Admin</title>
</head>
<body>
  <main>
    <h1><%= title %></h1>

    <section class="admin-new-form">

        <% if (type === 'product') { %>

            <form action="/admin/products/new" method="POST" enctype="multipart/form-data">

                <p>Namn</p>
                <input type="text" name="name">

                <p>Beskrivning</p>
                <textarea name="description"></textarea>

                <p>Bild</p>
                <input type="file" name="image">

                <P>Märke</P>
                <input type="text" name="brand">

                <p>SKU</p>
                <input type="text" name="SKU">

                <p>Pris</p>
                <input type="number" name="price" step="0.01">

                <p>Kategori</p>
                <select name="category_id">
                    <% categories.forEach(c => { %>
                        <option value="<%= c.id %>">
                            <%= c.name %>
                        </option>
                    <% }) %>
                </select> <br><br>

                <button type="submit">Lägg till produkt</button>

            </form>

        <% } %>

        <% if (type === 'category') { %>

            <form action="/admin/categories/new" method="POST">

                <p>Namn</p>
                <input type="text" name="name"><br><br>

                <button type="submit">Lägg till kategori</button>

            </form>

        <% } %>

    </section>
</main>
  

</body>
</html>