<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administation</title>
</head>
<body>
    <main>
        <section class="admin-sub-header">
            <h1>Produkter</h1>
            <a href="/admin/products/new" class="admin-new-button">Ny produkt</a>
        </section>

    <!-- Products table -->
        <table class="admin-table">
            <tr class="admin-table-row">  <!-- Top-row-->
                <td>Namn</td>
                <td>SKU</td>
                <td>Pris</td>
            </tr>
            <% products.forEach(product => { %>  <!-- product rows, based on products array -->
                <tr class="admin-table-row">
                    <td><%= product.name %></td>
                    <td><%= product.SKU %></td>
                    <td><%= product.price %> SEK</td>
                </tr>
            <% }); %>
        </table>
    </main>
</body>
</html>